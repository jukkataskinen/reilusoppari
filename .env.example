# Reilusoppari – ympäristömuuttujat (CLAUDE.md kohta 2)
# Kopioi tämä tiedosto nimellä .env.local ja täytä oikeat arvot.
#
# Testit (Vitest ja Playwright) EIVÄT lue .env.local:ia. Ne lukevat Supabase-
# avaimet tiedostosta .env.test.local, johon laitetaan vain erillisen kehitys-
# projektin (reilusoppari-dev) SUPABASE_URL, SUPABASE_ANON_KEY ja
# SUPABASE_SERVICE_ROLE_KEY, ei koskaan tuotannon. Ilman tiedostoa kantatestit
# ohitetaan kuten CI:ssä. Paikallinen e2e pysähtyy, jos .env.local on olemassa,
# koska Next.js-palvelin lukisi sen (ks. playwright.config.ts).

NEXT_PUBLIC_APP_URL=https://app.reilusoppari.fi

# --- Supabase (oma projekti, EU) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Palvelinpuolen avain. Ohittaa RLS:n, joten osapuolirajaus tehdään koodissa.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth0 passwordless (sähköpostikoodi, ei salasanoja) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# --- Auth0-tenantin asetusskripti (npm run auth0:asetukset) ---
# Tarvitaan vain tenanttia pystyttäessä, ei sovelluksen ajossa.
# Machine to Machine -sovellus uudessa tenantissa. Ks. auth0/AJO-OHJE.md.
AUTH0_MGMT_DOMAIN=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- eSinetti ---
# Tenant `reilusoppari`. Ilman avainta lib/esinetti kayttaa mock-toteutusta,
# jolla vaiheet 0 ja 1 etenevat ilman oikeaa yhteytta.
ESINETTI_API_URL=https://app.esinetti.fi/api/v1
ESINETTI_API_KEY=

# Webhookien allekirjoituksen tarkistus (X-eSinetti-Signature).
# Tyhja arvo EI tarkoita "tarkistus ohi": ilman tata kaikki webhookit hylataan.
ESINETTI_WEBHOOK_SECRET=

# HUOM: Reilusoppari EI kayta eSinetin asiakirjapohjia. Se tekee PDF:nsa itse
# (src/documents/), ja eSinetti vain kerää allekirjoitukset ja sinetoi.

# --- Kutsulinkkien allekirjoitus ---
# Generoi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_TOKEN_SECRET=
# Todistusten jakolinkit, sama muoto.
SHARE_TOKEN_SECRET=

# --- Osapuolten tunnistetietojen salaus ---
# Henkilotunnus tallennetaan kantaan VAIN talla avaimella salattuna
# (src/lib/identity/crypto.ts). Ilman avainta tunnusta ei voi tallentaa eika
# sopimukseen tulostaa. Generoi: npm run keys:person
PERSON_DATA_KEY=

# --- Sähköposti (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Web push (VAPID) ---
# Generoi: npm run keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Stripe (vaihe 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cron ---
CRON_SECRET=

# --- Kehitystoiveet ---
# Toiveiden käsittelijät (Reilusopparin ylläpito), pilkuilla erotettu lista
# sähköpostiosoitteita. Tyhjänä kukaan ei käsittele: jokainen näkee vain
# omat toiveensa. Ks. DECISIONS.md 2026-09-27.
FEATURE_REQUEST_ADMIN_EMAILS=

# --- Kehitysehdotukset: GitHub-seuranta (docs/kehitysehdotukset.md, Jukka 8.10.2026) ---
# Ilman GITHUB_ISSUES_TOKENia hyväksyntä tallentuu normaalisti, mutta
# GitHub-issueta ei luoda — käsittelysivu kertoo sen. Hienojakoinen token,
# oikeus vain tämän yhden repon Issues: read and write.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=jukkataskinen/reilusoppari

# Webhookin allekirjoituksen tarkistus (X-Hub-Signature-256), asetetaan
# samaksi GitHubin repoasetuksissa. Tyhjä arvo EI tarkoita "tarkistus ohi":
# ilman tätä kaikki webhookit hylätään.
GITHUB_WEBHOOK_SECRET=

# Koodaajan sähköposti (nyt Jukka): tähän lähtee ilmoitus uudesta
# kehitysehdotuksesta ja testauspyyntö, kun korjaus on yhdistetty.
KEHITYS_KOODAAJA_EMAIL=

# --- Virheseuranta (Sentry), valinnainen ---
# Ilman näitä Sentry ei tee mitään: ei verkkokutsuja, ei Sentryn koodia
# selaimeen eikä muutoksia CSP:hen. Ks. DECISIONS.md 2026-10-04.
#
# DSN: Sentry -> Settings -> Projects -> Client Keys (DSN). Julkinen
# tunniste, ei salaisuus (se näkyy selaimessa joka tapauksessa). Molemmille
# sama arvo. NEXT_PUBLIC_-muuttuja luetaan käännöksessä, joten muutos vaatii
# uuden julkaisun. Ympäristö (production / preview) tulee VERCEL_ENV:stä.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Lähdekartat (luettavat virherivit), valinnainen. Ilman tokenia lähde-
# karttoja ei tehdä eikä lähetetä. SENTRY_AUTH_TOKEN on salaisuus: Sentry ->
# Settings -> Auth Tokens (Organization Token). Vain Verceliin, ei selaimeen.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
